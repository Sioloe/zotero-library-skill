              "pattern": "^[1-9][0-9]*$"
            }
          },
          {
            "name": "collectionKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[23456789ABCDEFGHIJKLMNPQRSTUVWXYZ]{8}$"
            }
          },
          {
            "name": "v",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "enum": [
                3
              ],
              "default": 3
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
