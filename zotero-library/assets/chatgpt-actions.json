            }
          },
          {
            "name": "start",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "qmode",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "titleCreatorYear",
                "everything"
              ]
            }
          },
          {
            "name": "tag",
            "in": "query",
            "required": false,
